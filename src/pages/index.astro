---
import '../styles/global.css';
---

<html lang="en" class="dark scroll-smooth">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>FeatherBuilds | Hand-Coded, Feather-Light Websites</title>
    <meta name="description" content="Custom-coded websites built for speed, with fluid motion graphics that don't slow the page down." />
    <meta name="color-scheme" content="dark light" />

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600&family=Plus+Jakarta+Sans:wght@600;700;800&display=swap"
      media="print"
      onload="this.media='all'"
    />
    <noscript>
      <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600&family=Plus+Jakarta+Sans:wght@600;700;800&display=swap" />
    </noscript>

    <script is:inline>
      (function () {
        try {
          var t = localStorage.getItem('theme');
          if (t === 'light' || (!t && window.matchMedia('(prefers-color-scheme: light)').matches)) {
            document.documentElement.classList.remove('dark');
          }
        } catch (e) {}
      })();
    </script>
  </head>

  <body class="bg-linear-to-b from-sky-100 via-emerald-50/60 to-emerald-100/40 text-zinc-900 dark:from-[#05070a] dark:via-[#08100f] dark:to-[#06130f] dark:text-zinc-100 antialiased overflow-x-hidden transition-colors duration-500 min-h-screen">

    <!-- Back layer: sky, moon/sun, mountains, forest, bird, fireflies -->
    <canvas id="forest-canvas" class="fixed inset-0 w-full h-full pointer-events-none z-0" aria-hidden="true"></canvas>

    <header id="site-header" class="sticky top-0 z-30 border-b border-zinc-200/70 dark:border-white/5 bg-white/70 dark:bg-[#06080a]/70 backdrop-blur-md transition-colors duration-300">
      <div class="max-w-6xl mx-auto px-6 h-20 flex items-center justify-between">
        <a href="#" class="flex items-center gap-2.5 font-display font-extrabold text-xl tracking-tight text-zinc-950 dark:text-white">
          <span class="inline-flex items-center justify-center w-8 h-8 rounded-lg bg-emerald-500/15 border border-emerald-500/30 text-emerald-600 dark:text-emerald-400">
            <svg class="w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <path d="M20.24 12.24a6 6 0 0 0-8.49-8.49L5 10.5V19h8.5z"></path>
              <line x1="16" y1="8" x2="2" y2="22"></line>
              <line x1="17.5" y1="15" x2="9" y2="15"></line>
            </svg>
          </span>
          FeatherBuilds
        </a>

        <nav class="hidden md:flex items-center gap-8 text-sm font-medium text-zinc-600 dark:text-zinc-400" aria-label="Primary">
          <a href="#work" class="hover:text-zinc-950 dark:hover:text-white transition-colors">Work</a>
          <a href="#speed" class="hover:text-zinc-950 dark:hover:text-white transition-colors">Why Speed Matters</a>
          <a href="#pricing" class="hover:text-zinc-950 dark:hover:text-white transition-colors">Pricing</a>
        </nav>

        <div class="flex items-center gap-3">
          <button id="theme-toggle" type="button" aria-label="Toggle dark mode" class="p-2.5 rounded-full border border-zinc-200 dark:border-white/10 bg-white/80 dark:bg-white/5 text-zinc-700 dark:text-zinc-300 hover:border-emerald-500/50 transition-colors cursor-pointer">
            <svg class="w-4 h-4 hidden dark:block" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
              <circle cx="12" cy="12" r="4"></circle>
              <path d="M12 2v2M12 20v2M4.93 4.93l1.41 1.41M17.66 17.66l1.41 1.41M2 12h2M20 12h2M6.34 17.66l-1.41 1.41M19.07 4.93l-1.41 1.41"></path>
            </svg>
            <svg class="w-4 h-4 block dark:hidden" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
              <path d="M12 3a6 6 0 0 0 9 9 9 9 0 1 1-9-9Z"></path>
            </svg>
          </button>

          <a href="#contact" class="px-4 py-2 rounded-full bg-zinc-950 text-white dark:bg-white dark:text-zinc-950 font-semibold text-sm hover:bg-emerald-500 dark:hover:bg-emerald-400 hover:text-zinc-950 transition-colors">
            Start a Build
          </a>
        </div>
      </div>
    </header>

    <main class="relative z-10">
      <section class="max-w-6xl mx-auto px-6 pt-16 pb-32 md:pt-24 md:pb-40 text-center">

        <div data-perch="1" class="rise inline-flex items-center gap-2 px-3.5 py-1.5 rounded-full bg-white/80 dark:bg-white/[0.04] border border-emerald-500/20 dark:border-white/10 text-xs font-medium text-emerald-700 dark:text-emerald-300 mb-8 backdrop-blur-sm" style="--d:0.05s">
          <span class="w-2 h-2 rounded-full bg-emerald-500 dark:bg-emerald-400 animate-pulse"></span>
          100% Hand-Coded · Zero Page-Builder Bloat
        </div>

        <h1 class="rise font-display text-4xl sm:text-6xl md:text-7xl font-extrabold tracking-tight text-zinc-950 dark:text-white max-w-4xl mx-auto leading-[1.08]" style="--d:0.15s">
          Agency-grade design that feels <span class="grad-text">feather-light.</span>
        </h1>

        <p class="rise mt-6 text-lg md:text-xl text-zinc-700 dark:text-zinc-400 max-w-2xl mx-auto leading-relaxed" style="--d:0.28s">
          We build custom, motion-rich websites that load fast and score at the top of Google PageSpeed, turning more local traffic into paying customers.
        </p>

        <div class="rise mt-10 flex flex-col sm:flex-row items-center justify-center gap-4" style="--d:0.4s">
          <a data-perch="1" href="#pricing" class="w-full sm:w-auto px-8 py-4 rounded-full bg-emerald-500 dark:bg-emerald-400 text-zinc-950 font-bold text-base hover:bg-emerald-400 dark:hover:bg-emerald-300 transition-all shadow-[0_0_30px_-5px_rgba(16,185,129,0.45)]">
            See Packages ($0 Down)
          </a>
          <a data-perch="1" href="#speed" class="w-full sm:w-auto px-8 py-4 rounded-full bg-white/90 dark:bg-white/[0.05] border border-zinc-200 dark:border-white/10 text-zinc-900 dark:text-white font-semibold text-base hover:bg-white dark:hover:bg-white/10 transition-colors backdrop-blur-sm">
            Compare Load Speeds
          </a>
        </div>

        <!-- Primary landing surface: feathers pile up on this card -->
        <div id="feather-landing-zone" data-perch="5" data-occlude class="rise mt-20 md:mt-24 max-w-4xl mx-auto rounded-2xl bg-white/90 dark:bg-zinc-900/80 backdrop-blur-md border border-zinc-200/90 dark:border-white/10 ring-1 ring-inset ring-white/60 dark:ring-white/5 p-6 sm:p-10 shadow-xl dark:shadow-2xl relative transition-colors duration-300" style="--d:0.55s">
          <div class="grid grid-cols-1 md:grid-cols-3 gap-6 text-left">
            <div data-perch="1" class="p-5 rounded-xl bg-zinc-50/90 dark:bg-white/[0.03] border border-zinc-200/80 dark:border-white/5">
              <div class="text-xs font-semibold tracking-wide text-zinc-500">Google PageSpeed</div>
              <div class="mt-2 flex items-baseline gap-2">
                <span class="text-4xl font-extrabold text-emerald-600 dark:text-emerald-400 font-display">100</span>
                <span class="text-sm text-zinc-500 dark:text-zinc-400">/ 100</span>
              </div>
              <p class="mt-2 text-xs text-zinc-600 dark:text-zinc-400">No render-blocking scripts, no bloated plugins.</p>
            </div>

            <div data-perch="1" class="p-5 rounded-xl bg-zinc-50/90 dark:bg-white/[0.03] border border-zinc-200/80 dark:border-white/5">
              <div class="text-xs font-semibold tracking-wide text-zinc-500">First Contentful Paint</div>
              <div class="mt-2 flex items-baseline gap-2">
                <span class="text-4xl font-extrabold text-zinc-950 dark:text-white font-display">0.4s</span>
                <span class="text-xs text-emerald-600 dark:text-emerald-400 font-medium">Instant</span>
              </div>
              <p class="mt-2 text-xs text-zinc-600 dark:text-zinc-400">Edge-cached so visitors never wait.</p>
            </div>

            <div data-perch="1" class="p-5 rounded-xl bg-zinc-50/90 dark:bg-white/[0.03] border border-zinc-200/80 dark:border-white/5">
              <div class="text-xs font-semibold tracking-wide text-zinc-500">Total Page Weight</div>
              <div class="mt-2 flex items-baseline gap-2">
                <span class="text-4xl font-extrabold text-zinc-950 dark:text-white font-display">&lt;45KB</span>
                <span class="text-xs text-zinc-500 dark:text-zinc-400">vs 3.8MB avg</span>
              </div>
              <p class="mt-2 text-xs text-zinc-600 dark:text-zinc-400">Smooth vector motion, drawn at 60fps.</p>
            </div>
          </div>
          <p class="mt-5 text-xs text-zinc-500 text-center">
            Watch the forest. A bird glides in to perch, and now and then a feather drifts down onto the page. Move your cursor through the pile.
          </p>
        </div>

      </section>
    </main>

    <!-- Front layer: feathers draw above the content so they can land on it -->
    <canvas id="feather-canvas" class="fixed inset-0 w-full h-full pointer-events-none z-40" aria-hidden="true"></canvas>

    <script src="/feathers.js" defer></script>
  </body>
</html>